<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocationTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            
            <!-- Color Palette - Modern & Unique -->
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <Color x:Key="Secondary">#26A69A</Color>
            <Color x:Key="Accent">#FF6F00</Color>
            <Color x:Key="Success">#43A047</Color>
            <Color x:Key="Danger">#E53935</Color>
            <Color x:Key="Warning">#FB8C00</Color>
            <Color x:Key="White">White</Color>
            <Color x:Key="Black">Black</Color>
            <Color x:Key="Gray100">#F5F5F5</Color>
            <Color x:Key="Gray200">#E0E0E0</Color>
            <Color x:Key="Gray300">#BDBDBD</Color>
            <Color x:Key="Gray400">#9E9E9E</Color>
            <Color x:Key="Gray500">#757575</Color>
            <Color x:Key="Gray600">#616161</Color>
            <Color x:Key="Gray900">#212121</Color>
            
            <!-- Heat Map Colors -->
            <Color x:Key="HeatHigh">#E53935</Color>
            <Color x:Key="HeatMedium">#FB8C00</Color>
            <Color x:Key="HeatLow">#1E88E5</Color>
            
            <!-- Custom Button Styles -->
            
            <!-- Primary Action Button (Start Tracking) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="Shadow">
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.3" />
                </Setter>
            </Style>
            
            <!-- Danger Button (Stop Tracking) -->
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="Shadow">
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.3" />
                </Setter>
            </Style>
            
            <!-- Secondary Button (Refresh, Clear) -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="Shadow">
                    <Shadow Brush="Black" Offset="0,3" Radius="6" Opacity="0.2" />
                </Setter>
            </Style>
            
            <!-- Warning Button (Clear Data) -->
            <Style x:Key="WarningButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Warning}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="Shadow">
                    <Shadow Brush="Black" Offset="0,3" Radius="6" Opacity="0.2" />
                </Setter>
            </Style>

            <!-- Default Style for Labels -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Gray900}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>